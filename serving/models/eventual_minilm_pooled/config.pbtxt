name: "eventual_minilm_pooled"
platform: "onnxruntime_onnx"
max_batch_size: 0
input [
  { name: "input_ids" data_type: TYPE_INT64 dims: [-1, -1] },
  { name: "attention_mask" data_type: TYPE_INT64 dims: [-1, -1] },
  { name: "token_type_ids" data_type: TYPE_INT64 dims: [-1, -1] },
  { name: "NORMALIZE" data_type: TYPE_BOOL dims: [1] }
]
output [{ name: "EMBEDDING" data_type: TYPE_FP32 dims: [-1, 384] }]
instance_group [{ kind: KIND_GPU count: 1 gpus: [0] }]
version_policy { specific { versions: [1] } }
